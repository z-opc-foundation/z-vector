<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 消费入口统一走 z-boot-parent（1.0.19 起全组织口径）：继承第三方地板 z-boot-dependencies
         + import 兄弟仓权威 z-boot-fleet + 下发 Java 8 的 pluginManagement。
         这里原先的 parent 是 com.zifang:z-opc:1.0.0-SNAPSHOT —— 那个 pom 只存在于作者本机的
         ~/.m2，对外从不发布；而 <relativePath>../pom.xml</relativePath> 指的是 z-opc-foundation
         目录下**不存在**的 ../pom.xml（z-vector 自己就在 z-opc-foundation/ 里，上一层没有 pom）。
         结果就是"换台机器连 pom 都读不动"：本机装过旧 parent 时永远测不出来。
         relativePath 必须留空：新 parent 不在磁盘上，在 repo1。 -->
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-boot-parent</artifactId>
        <version>1.1.0</version>
        <relativePath/>
    </parent>

    <artifactId>z-vector</artifactId>
    <groupId>io.github.yuku123</groupId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>z-vector</name>
    <description>
        自研向量数据库 — 对标 Milvus / Qdrant / zvec / LanceDB / Chroma.
        设计融合: zvec 的 in-process 嵌入式架构 + LanceDB 的列存思想 + Chroma 的分层微服务.
        核心能力: HNSW/IVF/Flat ANN + L2/IP/Cosine/Hamming 距离 + Payload 过滤
                  + WAL/Snapshot 持久化 + Qdrant REST 兼容协议.    </description>
    <url>https://github.com/yuku123/z-vector</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-team</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/yuku123/z-vector.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/yuku123/z-vector.git</developerConnection>
        <url>https://github.com/yuku123/z-vector</url>
        <tag>HEAD</tag>
    </scm>


    <modules>
        <module>z-vector-api</module>
        <module>z-vector-core</module>
        <module>z-vector-storage</module>
        <module>z-vector-protocol</module>
        <module>z-vector-grpc-server</module>
        <module>z-vector-spring-boot-starter</module>
        <module>z-vector-server</module>
    </modules>

    <properties>
        <!-- 版本号只在这一处定义（改号只动这里）。子模块一律 `${revision}` 引父、不写自己的
             `<version>`，兄弟依赖也走下面的 dependencyManagement ⇒ 全仓不存在第二个版本字面量。
             代价是发布/安装的 pom 必须先把 `${revision}` 展开——flatten 因此挪出 central profile
             变成常开（见文末注释），否则 `mvn install` 会把带 `${revision}` 的 pom 装进 m2，
             下游解析 parent 时直接找不到构件。 -->
        <revision>1.0.5</revision>
        <!-- java.version / netty.version / jackson.version 三格 2026-09-28 迁移时删除：
             新父链面值逐字节相同（z-boot-parent:1.0.19 → java.version=1.8；
             z-boot-dependencies:1.0.19 → netty-bom 4.1.138.Final、jackson-bom 2.18.6），
             留着就是"每个仓自己再钉一遍"的旧账，删掉后 dependency:tree 实测一件没漂。
             ⚠ 删属性必须同时删掉引用它的 DM 条目/子模块 <version>，否则就是悬空属性。 -->
        <!-- release 门禁不在这里，见文末 profile jdk9-plus-release-gate。 -->
        <!-- maven.compiler.source/target 刻意留着：父链下发的是 "8"、这里是 "1.8"，
             javac 语义等价但**字面不同值**，不在"与父链同值可删"那一档；本仓 Java 8 线要在
             JDK 8 上跑 source/target（release 只在 JDK 9+ 生效），不在迁移这一刀里顺手换写法。 -->
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 第三方依赖版本：以下四格**必须留着自钉**，逐条对过父链（z-boot-dependencies:1.0.19
             + z-boot-fleet:1.0.0）的实测结果：
               grpc.version=1.65.1      → 地板的 io.grpc 条目 0 条（fleet 也 0），父链完全没供给；
               protobuf.version=3.25.5  → 地板只管 com.google.protobuf:protobuf-java 一件
                                          （面值恰好也是 3.25.5，字面量写法），**protobuf-java-util
                                          没有任何条目** ⇒ 删键 = 那一格悬空，Maven 当场报错；
               slf4j.version=2.0.13     → 地板不直接管 slf4j-api（只在 log4j-to-slf4j 里 exclude 它），
                                          实际走 import 进来的 spring-boot-dependencies 2.7.18 = 1.7.36，
                                          与本仓 2.0.13 **面值不同** ⇒ 删掉就是静默降版本；
               junit.version=5.10.2     → 地板的 junit-jupiter 是 5.9.3（property 名叫
                                          junit-jupiter.version），与本仓 5.10.2 **面值不同**。
             前两格是"父链没供给"，后两格是"父链给了但给得低" —— 删任意一格都等于不改判就换实现。 -->
        <grpc.version>1.65.1</grpc.version>
        <protobuf.version>3.25.5</protobuf.version>
        <slf4j.version>2.0.13</slf4j.version>
        <junit.version>5.10.2</junit.version>

        <!-- zutil.version 这一格 2026-09-28 迁移时删除：键名是全组织三种命名里最野的一种
             （fleet/地板用 z-util.version，另有 7 个仓用 util.version），但**面值 1.0.13 与
             fleet 的 z-util.version=1.0.13 完全相同** ⇒ 正确做法是删键 + 删掉引用它的
             <version>，由 fleet 的 dependencyManagement 下发，而不是留一个"改个名就能对齐"的分歧。 -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 本仓自家 8 个模块各钉一条 ${project.version}（含聚合 pom 自己那一格）。
                 这一格不是装饰：继承来的 DM 会改写**传递依赖**的版本，而 fleet 里 z-vector 那一格
                 钉的是 repo1 上的**已发布件**（实测 z-boot-fleet:1.0.0 → <z-vector.version>1.0.4</z-vector.version>，
                 覆盖 z-vector-api/core/storage/protocol/grpc-server/server/spring-boot-starter 七格）。
                 本仓当前 revision 恰好也是 1.0.4 ⇒ 今天补不补读数一样，但下一次抬 revision
                 （1.0.5）而不补这格时，仓内构建与 z-vector-server 的 shade fat jar 就会把**上一个
                 发布件的字节码**当 sibling 编进来 —— z-cache 试点实测踩过（1.3.6 的包里打进
                 1.3.5 的 z-cache-common）。所以按全组织口径把 8 格钉死在 ${project.version}。
                 fleet 没有 `io.github.yuku123:z-vector` 这一格（它只钉 7 个 jar 模块），
                 这条聚合 pom 的条目纯粹是把 8 个 reactor 坐标补齐、口径一致。 -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-vector</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-vector-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-vector-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-vector-storage</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-vector-protocol</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-vector-grpc-server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-vector-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-vector-server</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- netty-all / jackson-core / jackson-databind / jackson-annotations 四条连同
                 ${netty.version}/${jackson.version} 属性一并删除：父链的 io.netty:netty-bom
                 （4.1.138.Final）与 com.fasterxml.jackson:jackson-bom（2.18.6）面值相同，
                 改由父链下发；实测迁移后 dependency:tree 的 6 件 jackson 版本一件没动。
                 z-util-core/math/ml 三条同理删除，由 fleet 的 ${z-util.version}=1.0.13 下发。 -->

            <!-- gRPC / Protobuf / slf4j / junit：留着自钉，理由见上面 properties 里逐条实测的注释
                 （grpc 父链 0 条；protobuf-java-util 父链无条目；slf4j/junit 父链面值更低）。
                 ⚠ 这一族本仓的 DM 条目是**直接**条目，优先级高于继承来的 ⇒ 不会被父链改写。 -->
            <!-- gRPC -->
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-netty-shaded</artifactId>
                <version>${grpc.version}</version>
            </dependency>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-protobuf</artifactId>
                <version>${grpc.version}</version>
            </dependency>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-stub</artifactId>
                <version>${grpc.version}</version>
            </dependency>

            <!-- Protobuf -->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java-util</artifactId>
                <version>${protobuf.version}</version>
            </dependency>

            <!-- Logging -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.version}</version>
            </dependency>

            <!-- Testing -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- snakeyaml 必须按**坐标**写直接条目，不能指望任何 import：
                 迁移前旧 parent（com.zifang:z-opc）的 DM 钉的是 2.0（CVE-2022-1471 那一串），
                 而新父链跟着 spring-boot-dependencies 2.7.18 走 1.30 ⇒ 实测迁移后
                 dependency:tree 从 2.0 静默降到 1.30（这一轮 diff 里唯一的一行）。
                 同 z-cache 试点的处理：先在本仓把这一格顶住，"该由地板统一决定"的最终口径待 CEO 判。 -->
            <dependency>
                <groupId>org.yaml</groupId>
                <artifactId>snakeyaml</artifactId>
                <version>2.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
    <!-- 全仓统一测试台（parent <dependencies> 直供，所有子模块自动继承，
         子模块一律不再各自声明 junit；版本由根 DM / 地板 junit-bom 统一下发）：
           * junit-jupiter        — JUnit 5 新测试（API + 引擎）
           * junit-vintage-engine — 老 JUnit 4 测试（org.junit.Test）跑在 JUnit 5 平台上 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <scope>test</scope>
            <version>${junit.version}</version>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <!-- 这里不放 <release>：release 走 maven.compiler.release 属性，
                             由下面按 JDK 版本激活的 profile 提供（JDK 8 的 javac 没有 release 选项）。 -->
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- 发布/安装的 pom 必须自包含，两个理由各吃过一次教训：
                 1) 本仓的 parent 曾经是 com.zifang:z-opc:1.0.0-SNAPSHOT，它永远不会（也不能）出现在
                    Central 上。带着这个 parent 发出去的构件，任何外部消费者第一次解析就报
                    "Could not find artifact com.zifang:z-opc:pom:1.0.0-SNAPSHOT"，等于构件全废。
                    （2026-09-28 已把 parent 换成 repo1 上真实存在的 io.github.yuku123:z-boot-parent:1.0.19，
                     源码在别的机器上读得动了；但 flatten 常开的结论不变 —— 发布件仍不该把整条
                     parent 链和它的 DM 形状绑给下游。）
                 2) 版本现在写的是 ${revision}（只在本文件 properties 里定义一次）。带着
                    ${revision} 的 pom 一旦装进 ~/.m2，下游解析 parent 时按字面量找
                    "z-vector:${revision}" 这个目录 ⇒ 直接 404，而且是在别人的构建里炸。
                 flatten 在 process-resources 生成去掉 parent、把继承来的版本全部写死的 pom，
                 install/deploy 用它替换（updatePomFile）。
                 ⇒ 因此它必须常开，不能只挂在 central profile 上（改前就是挂 profile：
                   `mvn install` 不带 -P central 时装进去的 pom 会留着 ${revision}）。
                 （同款已先在 z-cache 1.3.3/1.3.4 验证：Central 上的 starter pom <parent> 计数 = 0） -->
            <!-- 版本钉在 1.5.0 不是随手写的：1.6.0 起 flatten-maven-plugin 声明
                 requireMavenVersion=3.6.3，而 Java 8 门禁机 250 跑的是 Maven 3.6.0 ⇒ 常开之后
                 每个构建（连 `mvn clean` 都要跑 flatten:clean）在门禁机上当场 BUILD FAILURE，
                 8 个模块一条测试都跑不到（2026-09-26 在 250 实测：1.5.0 rc=0、1.6.0/1.7.2/1.7.3 rc=1）。
                 抬这个版本号之前必须先在 250 上实测，别只看 changelog。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.5.0</version>
                <inherited>true</inherited>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>oss</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Java 8 兼容性的真门禁。source/target 只限制字节码版本，不限制能调用哪些 API：
             本机 JDK 25 上 "-source 1.8 -target 1.8" 会静静收下 Map.of（实测 rc=0），
             而 javac 的 release 开关（两个连字符）当场拒绝它。所以这道闸只在认识该开关的
             JDK（9 及以上）上开：JDK 8 的 javac 没有 release 开关，在它上面强行开会直接
             "Fatal error compiling: invalid flag"（250 实测），故按 jdk 版本激活。
             两个方向都要验：9+ 上 mvn help:evaluate 该出 8、源码里塞 Map.of 该变红；
             JDK 8 上该属性该是 undefined、mvn clean test 该全绿。
             （XML 注释里不许出现两个连续的连字符，pom 会解析失败——这里踩过一次。） -->
        <profile>
            <id>jdk9-plus-release-gate</id>
            <activation>
                <jdk>[9,)</jdk>
            </activation>
            <properties>
                <maven.compiler.release>8</maven.compiler.release>
            </properties>
        </profile>
        <profile>
            <id>central</id>
            <properties>
                <maven.javadoc.skip>false</maven.javadoc.skip>
                <central.gpg.skip>false</central.gpg.skip>
            </properties>
            <distributionManagement>
                <repository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </repository>
                <snapshotRepository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </snapshotRepository>
            </distributionManagement>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-deploy-plugin</artifactId>
                        <version>3.1.4</version>
                        <configuration><skip>true</skip></configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <doclint>none</doclint>
                            <failOnError>false</failOnError>
                            <failOnWarnings>false</failOnWarnings>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>verify</phase>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <configuration>
                            <skip>${central.gpg.skip}</skip>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                                <arg>--no-tty</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.8.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <tokenAuth>true</tokenAuth>
                            <autoPublish>true</autoPublish>
                            <waitUntil>uploaded</waitUntil>
                            <waitMaxTime>1800</waitMaxTime>
                            <waitPollingInterval>10</waitPollingInterval>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
