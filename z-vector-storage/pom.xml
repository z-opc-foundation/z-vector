    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
            <artifactId>z-vector</artifactId>
        <version>${revision}</version>
    </parent>
    <groupId>io.github.yuku123</groupId>

    <artifactId>z-vector-storage</artifactId>
    <packaging>jar</packaging>
    <name>z-vector-storage</name>
    <description>
        z-vector 持久化层 — Write-Ahead Log (WAL) + Snapshot + 二进制序列化.
        设计参考 zvec 的 LocalWalFile + LanceDB 的 Manifest + Faiss 的 I/O.
        保证崩溃恢复 + 数据可重放.
    </description>

    <url>https://github.com/yuku123/z-vector</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-team</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/yuku123/z-vector.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/yuku123/z-vector.git</developerConnection>
        <url>https://github.com/yuku123/z-vector</url>
        <tag>HEAD</tag>
    </scm>



    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-vector-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-vector-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.13</version>
        </dependency>
        <!-- 原 runtime 域 slf4j-simple 已删（2026-10-02）：storage 测试零用 slf4j（main 10
             文件走 slf4j-api），库件不替消费方写日志栈——这正是 z-opc main-starter 此前
             不得不在每个 dep 上手动加 <exclusion>slf4j-simple</exclusion> 的根因。 -->

        <!-- jackson-databind 的 <version>2.18.6</version> 已删：版本改由父链的 jackson-bom
             （z-boot-dependencies:1.0.19 → 2.18.6，与本仓原字面量同值）下发，实测 tree 没漂。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- z-util 复用：FileUtil.mkdirs 等文件工具
             排除 z-util-core 自带的 log4j-slf4j2-impl，避免与 Spring Boot 的 log4j-to-slf4j 冲突
             （<version>${zutil.version}</version> 同 core 模块一起删，改由 fleet 下发 1.0.13） -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-core</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j2-impl</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
</project>