<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
            <artifactId>z-vector</artifactId>
        <version>${revision}</version>
    </parent>
    <groupId>io.github.yuku123</groupId>

    <artifactId>z-vector-spring-boot-starter</artifactId>
    <packaging>jar</packaging>
    <name>z-vector :: spring-boot-starter</name>
    <description>
        z-vector Spring Boot 自动装配 — 一行引入即可获得 z-vector 全部能力。
        通过 spring.factories 自动加载，提供 REST 控制器、健康检查、配置属性。
    </description>

    <url>https://github.com/yuku123/z-vector</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-team</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/yuku123/z-vector.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/yuku123/z-vector.git</developerConnection>
        <url>https://github.com/yuku123/z-vector</url>
        <tag>HEAD</tag>
    </scm>



    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-vector-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-vector-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-vector-grpc-server</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <!-- 2026-11-18 第二轮：2.7.12 → 3.5.16（删掉字面版本，改走 parent DM）
                 起因 GHSA-mgvc-8q2h-5pgc（C:H，Actuator CloudFoundry 端点认证绕过）：
                 区间 introduced=0 / last_affected=2.7.18，introduced=3.0.0 / last_affected=3.3.13，
                 introduced=3.4.0 / last_affected=3.4.13，introduced=3.5.0 / fixed=3.5.12
                 ⇒ 2.7.12 命中，3.5.16 起干净。
                 抬版可行性已核：本 starter 源码**零 Boot2 专属 API**
                 （无 WebSecurityConfigurerAdapter / 无 javax.servlet），
                 自动装配已用 Boot3 的 META-INF/spring/...AutoConfiguration.imports 形态 ⇒ 纯版本回退残留。 -->
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.13</version>
        </dependency>
        <!-- 原 runtime 域 slf4j-simple 已删（2026-10-02）：本模块测试零用 slf4j，库件不替应用
             写日志栈——spring-boot-starter 把日志栈选型交给消费方应用决定。 -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>3.5.16</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>