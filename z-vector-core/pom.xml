        <!-- z-util 复用：KMeans（替代自研）/ NdArray / Linalg / FileUtil
             排除 z-util-core 自带的 log4j-slf4j2-impl，避免与 Spring Boot 的 log4j-to-slf4j 冲突；
             由调用方按需引入日志后端（z-vector-core 自身用 slf4j-simple 即可）。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-ml</artifactId>
            <version>1.0.9</version>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j2-impl</artifactId>
